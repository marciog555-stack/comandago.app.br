# Cliente (exposto ao browser — precisa do prefixo VITE_)
VITE_SUPABASE_URL=https://cxcczrmpaksawaispqqb.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_VmarThvbrp79tZJLw7X3pw_DbtgairM

# Servidor apenas — NUNCA prefixar com VITE_ (isso o incluiria no bundle do
# browser). Bypassa RLS por completo. Pegue no painel do Supabase em
# Project Settings > API > service_role.
SUPABASE_SERVICE_ROLE_KEY=

# Domínio de apex usado pelo middleware de hostname (src/infrastructure/hostname)
# pra distinguir landing / painel / loja por subdomínio. Opcional — default
# 'comandago.app.br' se não definida.
COMANDAGO_APEX_DOMAIN=comandago.app.br

# E-mails com acesso à tela de provisionamento (/admin — só Márcio, seção 7
# do briefing). Separados por vírgula. Sem essa variável, /admin fica
# inacessível pra qualquer login.
COMANDAGO_ADMIN_EMAILS=marciog555@gmail.com
